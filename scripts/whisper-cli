#!/usr/bin/env bash

PROJECT="/home/murat/Project/whisper"
MODELS="$PROJECT/.local/kokoro"
OUTPUT="$PROJECT/.local/outputs"
IMAGE="orioninsist/kokoro:rebuild-test"
SELINUX_LEVEL="s0:c463,c896"

usage() {
    printf '%s\n' \
        'Kullanim:' \
        '  whisper tts "Metin" [female|male] [dosya.wav]'
}

if [ "${1:-}" != "tts" ]; then
    usage
elif [ -z "${2:-}" ]; then
    printf 'HATA: Metin gerekli.\n' >&2
else
    TEXT="$2"
    VOICE="${3:-female}"
    NAME="${4:-speech.wav}"

    if [ "$VOICE" != "female" ] && [ "$VOICE" != "male" ]; then
        printf 'HATA: Ses female veya male olmali.\n' >&2
    elif [[ "$NAME" == */* ]] || [[ "$NAME" != *.wav ]]; then
        printf 'HATA: Yalnizca .wav dosya adi kullanin.\n' >&2
    elif [ -e "$OUTPUT/$NAME" ] || [ -L "$OUTPUT/$NAME" ]; then
        printf 'HATA: Cikti dosyasi zaten mevcut: %s\n' "$NAME" >&2
    else
        docker run --rm \
            --user "$(id -u):$(id -g)" \
            --network none \
            --read-only \
            --tmpfs /tmp:rw,nosuid,nodev,size=256m \
            --security-opt no-new-privileges \
            --security-opt "label=level:$SELINUX_LEVEL" \
            --cap-drop ALL \
            --mount "type=bind,src=$MODELS,dst=/models,readonly" \
            --mount "type=bind,src=$PROJECT/scripts/kokoro-tts.py,dst=/app/kokoro-tts.py,readonly" \
            --mount "type=bind,src=$OUTPUT,dst=/output" \
            --env HF_HUB_OFFLINE=1 \
            --env HF_HUB_DISABLE_TELEMETRY=1 \
            --entrypoint python \
            "$IMAGE" \
            /app/kokoro-tts.py \
            --text "$TEXT" \
            --voice "$VOICE" \
            --output "/output/$NAME"
    fi
fi
