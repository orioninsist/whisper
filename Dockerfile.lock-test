FROM python:3.11-slim-bookworm

COPY --from=ghcr.io/astral-sh/uv:0.12.24 /uv /uvx /bin/

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV UV_NO_CACHE=1

WORKDIR /app

COPY requirements-whisper-cpu.txt /app/

RUN uv pip install --system \
    --require-hashes \
    --index-strategy first-index \
    --torch-backend cpu \
    -r /app/requirements-whisper-cpu.txt

CMD ["python", "-c", "import torch, numba, numpy, tiktoken; print('Whisper CPU dependencies OK')"]
